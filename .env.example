# Copy to .env next to server.mjs. Every setting is optional.

# Where the dashboard listens. Keep 127.0.0.1 unless you also set DASH_PASSWORD.
# DASH_HOST=127.0.0.1
# DASH_PORT=8790

# Required when DASH_HOST is not 127.0.0.1: the login password.
# DASH_PASSWORD=

# Hostnames (with port) you open the dashboard by, besides localhost.
# DASH_ALLOWED_HOSTS=my-server.local:8790,192.0.2.10:8790

# How agents are told who is writing in #squad.
# DASH_USER_NAME=the user

# Hermes home to discover profiles in (default: ~/.hermes). Set HERMES_DISCOVER=false to use only squad.json.
# HERMES_HOME=/home/you/.hermes
# HERMES_DISCOVER=true

# API keys for agents the dashboard can't read from a local profile .env
# (Hermes on another machine or in Docker). Name: HERMES_KEY_<AGENT_ID>.
# HERMES_KEY_REMOTE_HELPER=
